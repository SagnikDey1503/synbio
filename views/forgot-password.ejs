<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Forgot Password - Quizzicles</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet" />

  <!-- Font Awesome for icons -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

  <!-- Your custom stylesheet -->
  <link rel="stylesheet" href="/style1.css" />
</head>
<body>
  <div class="login-container">
    <div class="login-card">
      <div class="logo-section">
        <div class="logo">
          <i class="fas fa-brain" style="font-size: 2rem; color: #ffffff;"></i>
        </div>
        <h1 style="margin-bottom: 0.3rem;">Quizzicles</h1>
        <p style="margin-top: 0;">Reset your password</p>
      </div>

      <form action="/forgot-password" method="POST" class="login-form">
        <div class="form-group">
          <label for="email">Enter your registered email</label>
          <div class="input-wrapper">
            <i class="fas fa-envelope"></i>
            <input type="email" name="email" id="email" required placeholder="example@domain.com" />
          </div>
        </div>

        <button type="submit" class="login-btn">
          <span>Send Reset Link</span>
          <i class="fas fa-paper-plane"></i>
        </button>
      </form>

      <% if (error) { %>
        <div class="error-message" style="color: red; margin-top: 1rem;"><%= error %></div>
      <% } %>

      <% if (success) { %>
        <div class="success-message" style="color: green; margin-top: 1rem;"><%= success %></div>
      <% } %>

      <div style="margin-top: 2rem; text-align: center;">
        <a 
          href="/login"
          class="exam-portal-link"
          style="
            display: inline-block;
            padding: 0.6rem 1.2rem;
            background-color: #4CAF50;
            color: white;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
          "
        >
          ← Back to Login
        </a>
      </div>

      <style>
        .exam-portal-link:hover {
          background-color: #45a049;
          transform: translateY(-2px) scale(1.03);
          box-shadow: 0 6px 12px rgba(76, 175, 80, 0.4);
        }
      </style>
    </div>
  </div>
</body>
</html>
