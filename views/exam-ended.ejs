<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>QUIZZICLES - Exam Ended</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #6366f1;
      --primary-dark: #4f46e5;
      --white: #fff;
      --gray-700: #374151;
      --gray-900: #111827;
      --radius-lg: 0.75rem;
      --shadow-lg: 0 10px 15px -3px rgba(99, 102, 241, 0.10), 0 4px 6px -2px rgba(0,0,0,0.05);
    }
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #6366f1 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gray-900);
      padding: 1rem;
    }
    .ended-container {
      background: var(--white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: 2.5rem 2rem;
      max-width: 420px;
      width: 100%;
      text-align: center;
    }
    .logo {
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      border-radius: 50%;
      width: 64px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem auto;
      box-shadow: 0 2px 8px rgba(99,102,241,0.12);
    }
    .logo i {
      color: #fff;
      font-size: 2rem;
    }
    .ended-title {
      font-size: 1.7rem;
      font-weight: 700;
      color: var(--primary-dark);
      margin-bottom: 0.75rem;
    }
    .ended-msg {
      color: var(--gray-700);
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }
    .home-button {
      background-color: var(--primary);
      color: white;
      padding: 0.75rem 1.25rem;
      border: none;
      border-radius: var(--radius-lg);
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: background-color 0.2s ease;
    }
    .home-button:hover {
      background-color: var(--primary-dark);
    }
  </style>
</head>
<body>
  <div class="ended-container">
    <div class="logo">
      <i class="fas fa-lock"></i>
    </div>
    <div class="ended-title">Exam Portal Closed</div>
    <div class="ended-msg">
      The QUIZZICLES exam session has ended. Thank you for participating!
    </div>
    <a href="/" class="home-button"><i class="fas fa-home"></i> Go to Homepage</a>
  </div>
</body>
</html>
