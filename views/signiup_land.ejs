<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Quizzicles Contest Portal</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/style1.css" />
</head>
<body>
  <div id="signup-page" class="page">
    <div class="login-container">
      <div class="login-card">
        <div class="logo-section">
          <div class="logo">
            <i class="fas fa-brain"></i>
          </div>
          <h1>Quizzicles</h1>
          <p>Sign Up</p>
        </div>
        <form id="signup-form" class="login-form" method="POST" action="/signup">
          <div class="form-group">
            <label for="signup-username">Username</label>
            <div class="input-wrapper">
              <i class="fas fa-user"></i>
              <input type="text" id="signup-username" name="username" value="<%= typeof username !== 'undefined' ? username : '' %>" required />
            </div>
          </div>
          <div class="form-group">
            <label for="signup-password">Password</label>
            <div class="input-wrapper">
              <i class="fas fa-lock"></i>
              <input type="password" id="signup-password" name="password" placeholder="Enter at least 6 characters" required />
            </div>
          </div>
          <div class="form-group">
            <label for="signup-fullname">Full Name</label>
            <div class="input-wrapper">
              <i class="fas fa-user"></i>
              <input type="text" id="signup-fullname" name="fullName" value="<%= typeof fullName !== 'undefined' ? fullName : '' %>" required />
            </div>
          </div>
          <div class="form-group">
            <label for="signup-category">Category</label>
            <div class="input-wrapper">
              <i class="fas fa-users"></i>
              <select id="signup-category" name="category" required>
                <option value="">Select your category</option>
                <option value="Class 8-12 and UG 1st year">Class 8-12 & UG 1st Year</option>
                <option value="open">Open</option>
              </select>
            </div>
          </div>
          <button type="submit" class="login-btn">
            <span>Register</span>
            <i class="fas fa-user-plus"></i>
          </button>
        </form>
        <div style="margin-top: 1rem; text-align: center;">
  <a href="/login" id="goto-login-link" class="exam-portal-link"
     style="
      display: inline-block;
      padding: 0.6rem 1.2rem;
      background-color: #4CAF50;
      color: white;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s ease;
     ">
    <i class="fas fa-arrow-right-to-bracket" style="margin-right: 8px;"></i>
    Go to Exam Portal
  </a>
</div>
<% if (error) { %>
          <div id="signup-error" class="error-message" style="color:red; margin-top: 10px;"><%= error %></div>
        <% } %>

        <% if (success) { %>
          <div id="signup-success" class="success-message" style="color:green; margin-top: 10px;">
            <%= success %><br>
            Redirecting to exam portal in <span id="countdown">5</span> seconds...
          </div>
          <script>
            let seconds = 5;
            const countdown = document.getElementById('countdown');
            const interval = setInterval(function() {
              seconds--;
              countdown.textContent = seconds;
              if (seconds <= 0) {
                clearInterval(interval);
                window.location.href = '/login';
              }
            }, 1000);
          </script>
        <% } %>
       <div style="margin-top: 1rem; text-align: center;">
<a 
  href="https://chat.whatsapp.com/DzfdxIdonrzJh1mtU5BagK" 
  target="_blank" 
  class="whatsapp-link"
  style="color: #25D366; font-weight: 500; text-decoration: none; display: inline-block; margin-top: 5px;">
  <i class="fab fa-whatsapp"></i> Contact us on WhatsApp
</a>

<style>
  .whatsapp-link:hover {
    color: #1ebe57;
    text-decoration: underline;
    transform: scale(1.03);
    transition: all 0.2s ease;
  }
</style>
<div class="external-links" style="margin-bottom: 1rem; margin-top: 0.5rem; text-align: center;">
  <a href="https://discord.gg/yourservercode" target="_blank" class="external-link discord-link" 
     style="text-decoration: none; color: #5865F2; font-weight: 500;">
    <i class="fab fa-discord"></i>
    <span>Join our Discord</span>
  </a>
</div>

<style>
  .discord-link:hover {
    color: #4854d4;
    text-decoration: underline;
    transition: color 0.3s ease, text-decoration 0.3s ease;
  }
</style>



</div> 
        

    
      
<style>
  .exam-portal-link:hover {
    background-color: #45a049;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 8px 16px rgba(76, 175, 80, 0.4);
    text-decoration: none;
  }
</style>


      </div>
    </div>
  </div>
</body>
</html>
