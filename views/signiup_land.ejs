<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>SYNBIOCON Registration Portal</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/style1.css" />
</head>

<body>
  <div id="signup-page" class="page">
    <div class="login-container">
      <div class="login-card">

        <div class="logo-section">
        <div class="event-logo">
  <img src="images/logo.png" alt="SYNBIOCON Logo" />
</div>

          <p>Register here</p>
        </div>

        <form id="signup-form" class="login-form" method="POST" action="/signup">

          <!-- 👤 Full Name -->
          <div class="form-group">
            <label for="signup-fullname">Full Name</label>
            <div class="input-wrapper">
              <i class="fas fa-user"></i>
              <input
                type="text"
                id="signup-fullname"
                name="fullName"
                value="<%= typeof fullName !== 'undefined' ? fullName : '' %>"
                required
              />
            </div>
          </div>

          <!-- 📧 Email -->
          <div class="form-group">
            <label for="signup-email">Email</label>
            <div class="input-wrapper">
              <i class="fas fa-envelope"></i>
              <input
                type="email"
                id="signup-email"
                name="email"
                value="<%= typeof email !== 'undefined' ? email : '' %>"
                required
              />
            </div>
          </div>

          <!-- 📞 Phone Number -->
          <div class="form-group">
            <label for="signup-phone">Phone Number</label>
            <div class="input-wrapper">
              <i class="fas fa-phone"></i>
              <input
                type="tel"
                id="signup-phone"
                name="phoneNumber"
                pattern="[6-9]{1}[0-9]{9}"
                placeholder="10-digit mobile number"
                value="<%= typeof phoneNumber !== 'undefined' ? phoneNumber : '' %>"
                required
              />
            </div>
          </div>
<!-- 🏫 Institute -->
<div class="form-group">
  <label for="signup-institute">Institute</label>
  <div class="input-wrapper">
    <i class="fas fa-university"></i>
    <input
      type="text"
      id="signup-institute"
      name="institute"
      value="<%= typeof institute !== 'undefined' ? institute : '' %>"
      required
    />
  </div>
</div>

<!-- 🎓 Degree -->
<div class="form-group">
  <label for="signup-degree">Degree</label>
  <div class="input-wrapper">
    <i class="fas fa-graduation-cap"></i>
    <select
      id="signup-degree"
      name="degree"
      required
    >
      <option value="">Select your degree</option>
      <option value="BTech" <%= degree === 'BTech' ? 'selected' : '' %>>B.Tech</option>
      <option value="MTech" <%= degree === 'MTech' ? 'selected' : '' %>>M.Tech</option>
      <option value="BS" <%= degree === 'BS' ? 'selected' : '' %>>BS</option>
      <option value="MS" <%= degree === 'MS' ? 'selected' : '' %>>MS</option>
      <option value="PhD" <%= degree === 'PhD' ? 'selected' : '' %>>PhD</option>
      <option value="Other" <%= degree === 'Other' ? 'selected' : '' %>>Other</option>
    </select>
  </div>
</div>

<!-- 💡 What do you expect (Optional) -->
<div class="form-group">
  <label for="signup-expectations" class="label-inline">
  <span>What do you expect from SYNBIOCON? </span>
  <span class="optional-tag">(Optional)</span>
</label>

  <div class="input-wrapper">
    <i class="fas fa-lightbulb"></i>
    <input
  type="text"
  id="signup-expectations"
  name="expectations"
  class="optional-textarea"
  value="<%= typeof expectations !== 'undefined' ? expectations : '' %>"
/>


  </div>
</div>

          <button type="submit" class="login-btn">
            <span>Register</span>
            <i class="fas fa-user-plus"></i>
          </button>
        </form>

        <% if (error) { %>
          <div class="error-message" style="color:red; margin-top: 10px;">
            <%= error %>
          </div>
        <% } %>

        <% if (success) { %>
          <div class="success-message" style="color:rgb(18, 214, 18); margin-top: 10px;">
            <%= success %>
          </div>
        <% } %>

        <!-- WhatsApp -->
        <div style="margin-top: 1rem; text-align: center;">
          <a
            href="https://chat.whatsapp.com/DzfdxIdonrzJh1mtU5BagK"
            target="_blank"
            style="color: #25D366; font-weight: 500; text-decoration: none;"
          >
            <i class="fab fa-whatsapp"></i> Contact us on WhatsApp
          </a>
        </div>

        <!-- Instagram -->
      <div class="external-links">
  <a
    href="https://www.instagram.com/igem_iitb/"
    target="_blank"
    class="ig-link"
  >
    <i class="fab fa-instagram"></i> Follow iGem
  </a>

  <a
    href="https://www.instagram.com/bioengene.iitkgp/"
    target="_blank"
    class="ig-link"
  >
    <i class="fab fa-instagram"></i> Follow BioEngene
  </a>
</div>


      </div>
    </div>
  </div>
</body>
</html>
