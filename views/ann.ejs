<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>QUIZZICLES Announcements</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* Styles same as your original, trimmed for clarity */
    :root {
      --primary: #6366f1;
      --primary-dark: #4f46e5;
      --primary-light: #8b5cf6;
      --error: #ef4444;
      --warning: #f59e0b;
      --white: #fff;
      --gray-50: #f9fafb;
      --gray-100: #f3f4f6;
      --gray-700: #374151;
      --gray-900: #111827;
      --radius-lg: 0.75rem;
      --shadow-lg: 0 10px 15px -3px rgba(99, 102, 241, 0.10), 0 4px 6px -2px rgba(0,0,0,0.05);
    }
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #6366f1 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gray-900);
      padding: 2rem;
    }
    .container {
      background: var(--white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: 2.5rem 2rem;
      max-width: 600px;
      width: 100%;
    }
    .logo {
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      border-radius: 50%;
      width: 64px;
      height: 64px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem auto;
    }
    .logo i {
      color: #fff;
      font-size: 2rem;
    }
    .title {
      text-align: center;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--primary-dark);
      margin-bottom: 1.5rem;
    }
    .announcements-section {
      text-align: left;
    }
    .announcements-title {
      font-weight: 600;
      color: var(--primary);
      margin-bottom: 0.75rem;
      font-size: 1.1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .announcement-card {
      background: var(--gray-100);
      border-left: 4px solid var(--primary);
      border-radius: var(--radius-lg);
      padding: 1rem;
      margin-bottom: 1rem;
    }
    .announcement-card.urgent { border-left-color: var(--error); }
    .announcement-card.correction { border-left-color: var(--warning); }
    .announcement-title {
      font-weight: 600;
      color: var(--gray-900);
      margin-bottom: 0.25rem;
      font-size: 1.05rem;
    }
    .announcement-content {
      color: var(--gray-700);
      margin-bottom: 0.35rem;
      font-size: 0.98rem;
    }
    .announcement-meta {
      font-size: 0.85rem;
      color: var(--gray-500);
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="logo">
      <i class="fas fa-bullhorn"></i>
    </div>
    <div class="title">QUIZZICLES Announcements</div>

    <% if (announcements && announcements.length > 0) { %>
      <div class="announcements-section">
        <div class="announcements-title"><i class="fas fa-bullhorn"></i> Latest Announcements</div>
        <% announcements.forEach(a => { %>
          <div class="announcement-card <%= a.type %>">
            <div class="announcement-title"><%= a.title %></div>
            <div class="announcement-content"><%= a.content %></div>
            <div class="announcement-meta"><%= a.formattedDate %></div>



          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p>No announcements at the moment.</p>
    <% } %>
  </div>
</body>
</html>
