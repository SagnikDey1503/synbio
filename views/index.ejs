<style>
#responseMessage {
  position: relative;
}

.response-box {
  position: relative;
  padding: 16px 20px;
  border-radius: 10px;
  margin-top: 16px;
  margin-bottom: 14px;
  font-weight: 500;
  font-size: 15px;
  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
  max-width: 400px;
  animation: slideInRight 0.5s ease-out;
  transition: all 0.3s ease;
}

.response-box.success {
  background-color: #e6ffed;
  color: #227d3d;
  border-left: 6px solid #2ecc71;
}

.response-box.error {
  background-color: #ffe6e6;
  color: #c0392b;
  border-left: 6px solid #e74c3c;
}

.close-btn {
  position: absolute;
  top: 8px;
  right: 14px;
  font-size: 22px;
  font-weight: bold;
  cursor: pointer;
  color: inherit;
  transition: transform 0.2s ease;
}

.close-btn:hover {
  transform: scale(1.2);
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(100px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
.animated-button {
  background-color: #21aac2;
  color: #ffffff;
  font-size: 1.1rem;
  font-family: 'Segoe UI', 'Roboto', sans-serif;
  padding: 1rem 1.5rem;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: background-color 0.3s, transform 0.2s;
  animation: pulseGlow 2s infinite;
  box-shadow: 0 4px 10px rgba(41, 98, 255, 0.4);
}

@keyframes pulseGlow {
  0% {
    box-shadow: 0 0 0px rgba(255, 255, 255, 0.3);
  }
  50% {
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.5);
  }
  100% {
    box-shadow: 0 0 0px rgba(255, 255, 255, 0.3);
  }
}

.animated-button:hover {
  background-color: #147f92;
  transform: scale(1.05);
}

</style>

