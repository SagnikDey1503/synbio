<script>
document.getElementById('contactForm').addEventListener('submit', async function (e) {
  e.preventDefault();

  const form = e.target;
  const name = form.name.value.trim();
  const email = form.email.value.trim();
  const subject = form.subject.value.trim();
  const message = form.message.value.trim();

  const responseDiv = document.getElementById('responseMessage');
  responseDiv.innerHTML = ''; // Clear previous message

  const createMessageBox = (msg, type = 'success') => {
    return `
      <div class="response-box ${type}">
        <span class="close-btn" onclick="this.parentElement.style.display='none';">&times;</span>
        ${msg}
      </div>
    `;
  };

  try {
    const res = await fetch('/query', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ name, email, subject, message })
    });

    const result = await res.json();

    if (result.success) {
      responseDiv.innerHTML = createMessageBox(result.message, 'success');
      form.reset();
    } else {
      responseDiv.innerHTML = createMessageBox(result.message, 'error');
    }
  } catch (err) {
    responseDiv.innerHTML = createMessageBox('An error occurred. Please try again.', 'error');
  }
});
</script>

