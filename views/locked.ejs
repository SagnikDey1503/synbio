<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>QUIZZICLES Portal Locked</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    :root {
      --primary: #6366f1;
      --primary-dark: #4f46e5;
      --primary-light: #8b5cf6;
      --success: #10b981;
      --warning: #f59e0b;
      --error: #ef4444;
      --info: #3b82f6;
      --white: #fff;
      --gray-50: #f9fafb;
      --gray-100: #f3f4f6;
      --gray-200: #e5e7eb;
      --gray-700: #374151;
      --gray-900: #111827;
      --radius-lg: 0.75rem;
      --shadow-lg: 0 10px 15px -3px rgba(99, 102, 241, 0.10), 0 4px 6px -2px rgba(0,0,0,0.05);
    }
    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(135deg, #6366f1 0%, #764ba2 100%);
      min-height: 100vh;
      margin: 0;
      padding: 0.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gray-900);
    }
    .locked-container {
      background: var(--white);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      padding: 1.5rem 1rem;
      max-width: 400px;
      width: 100%;
      text-align: center;
    }
    .logo {
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      border-radius: 50%;
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 0.75rem;
      box-shadow: 0 2px 8px rgba(99,102,241,0.12);
    }
    .logo i {
      color: #fff;
      font-size: 1.8rem;
    }
    .locked-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--primary-dark);
      margin-bottom: 0.5rem;
    }
    .locked-msg {
      color: var(--gray-700);
      font-size: 1rem;
      margin-bottom: 1rem;
    }
    .countdown-block {
      background: var(--gray-50);
      border-radius: var(--radius-lg);
      padding: 1rem;
      font-weight: 600;
      font-size: 1rem;
      color: var(--primary-dark);
      margin-bottom: 1.25rem;
    }
    .countdown-label {
      font-size: 0.9rem;
      color: var(--gray-700);
      margin-bottom: 0.25rem;
      display: block;
    }
    .announcements-title {
      font-weight: 600;
      color: var(--primary);
      font-size: 1rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.5rem;
    }
    .announcement-card {
      background: var(--gray-100);
      border-left: 4px solid var(--primary);
      border-radius: var(--radius-lg);
      padding: 0.75rem;
      margin-bottom: 0.75rem;
    }
    .announcement-card.urgent { border-left-color: var(--error); }
    .announcement-card.correction { border-left-color: var(--warning); }
    .announcement-title {
      font-weight: 600;
      font-size: 0.98rem;
      margin-bottom: 0.25rem;
    }
    .announcement-content {
      font-size: 0.92rem;
      color: var(--gray-700);
    }
    .announcement-meta {
      font-size: 0.8rem;
      color: var(--gray-500);
      margin-top: 0.25rem;
    }
    .link-buttons {
      margin-top: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .link-buttons a {
      padding: 0.6rem;
      border-radius: var(--radius-lg);
      font-weight: 600;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      box-shadow: var(--shadow-lg);
    }
    .btn-whatsapp { background-color: #25D366; color: white; }
    .btn-discord { background-color: #5865F2; color: white; }
    .btn-home { background-color: var(--gray-200); color: var(--gray-900); }
  </style>
</head>
<body>
  <div class="locked-container">
    <div class="logo">
      <i class="fas fa-brain"></i>
    </div>
    <div class="locked-title">Exam Portal Locked</div>
    <div class="locked-msg"><%= message %></div>

    <div class="countdown-block">
      <span class="countdown-label"><i class="fas fa-clock"></i> Time left for opening:</span>
      <span id="countdown">Calculating...</span>
    </div>

    <% if (announcements && announcements.length > 0) { %>
      <div class="announcements-section">
        <div class="announcements-title"><i class="fas fa-bullhorn"></i> Announcements</div>
        <% announcements.forEach(a => { %>
          <div class="announcement-card <%= a.type %>">
            <div class="announcement-title"><%= a.title %></div>
            <div class="announcement-content"><%= a.content %></div>
            <div class="announcement-meta"><%= new Date(a.createdAt).toLocaleString() %></div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="link-buttons">
      <a href="https://chat.whatsapp.com/DzfdxIdonrzJh1mtU5BagK" target="_blank" class="btn-whatsapp">
        <i class="fab fa-whatsapp"></i> WhatsApp
      </a>
      <a href="https://discord.gg/Fc9wZuU9" target="_blank" class="btn-discord">
        <i class="fab fa-discord"></i> Discord
      </a>
      <a href="/" class="btn-home">
        <i class="fas fa-home"></i> Return to Home
      </a>
    </div>
  </div>

  <script>
    const unlockTime = new Date("<%= unlockTimeISO %>");
    const countdownEl = document.getElementById('countdown');

    function updateCountdown() {
      const now = new Date();
      const diff = unlockTime - now;
      if (diff <= 0) {
        countdownEl.innerText = "Portal is opening... Please refresh.";
        return;
      }

      const totalSeconds = Math.floor(diff / 1000);
      const days = Math.floor(totalSeconds / (3600 * 24));
      const hours = Math.floor((totalSeconds % (3600 * 24)) / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;

      let countdownText = '';
      if (days > 0) {
        countdownText += `${days} day${days > 1 ? 's' : ''} `;
      }
      countdownText += `${hours} hr ${minutes} min ${seconds} sec`;
      countdownEl.innerText = countdownText;
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</body>
</html>
