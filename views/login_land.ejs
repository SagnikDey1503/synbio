<style>
.countdown-container {
    position: fixed;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;

    background: #ffffff;
    color: #2c3e50;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 1.1rem;
    padding: 10px 16px;
    border-radius: 12px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    width: fit-content;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s ease;
}

.countdown-container:hover {
    background-color: #f9f9f9;
    transform: translateX(-50%) scale(1.02);
}

#time-remaining {
    font-size: 1.1rem;
    font-weight: 700;
    color: #e74c3c;
    letter-spacing: 0.5px;
    animation: pulse 1s infinite ease-in-out;
}

/* Pulse animation */
@keyframes pulse {
    0% { opacity: 1; }
    50% { opacity: 0.6; }
    100% { opacity: 1; }
}

/* Even smaller on phones */
@media (max-width: 610px) {
  .countdown-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    position: fixed;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    padding: 0;
    font-size: 0.75rem;
    gap: 3px;
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    background: #fff;
    z-index: 999;
    width: 30vw;
  }

  #time-remaining {
    font-size: 0.78rem;
    letter-spacing: 0.3px;
    font-weight: 600;
    color: #e74c3c;
    animation: none; /* remove pulse for smaller display */
  }
}
@media (max-width: 500px) {
  .countdown-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    position: fixed;
    top: -5px;
    left: 55%;
    transform: translateX(-50%);
    padding: 0;
   font-size: 10px;
    gap: 3px;
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
    background: #fff;
    z-index: 999;
    width: 30vw;
  }

  #time-remaining {
    font-size: 0.6rem;
    letter-spacing: 0.3px;
    font-weight: 600;
    color: #e74c3c;
    animation: none; /* remove pulse for smaller display */
  }
}


</style>




